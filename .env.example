# Боевой магазин ЮKassa для самозанятого.
# Оба поля пустые — сайт в тестовом режиме: платёж не создаётся и продажей не считается.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# yes — только в день, когда боевой магазин открыт покупателям по публичному https.
# Это включает срок в 6 недель. Для репетиции оставьте пустым.
YOOKASSA_LIVE=

# Без слэша в конце. Для боевого режима нужен публичный https, не localhost.
PUBLIC_BASE_URL=http://localhost:3000

# Получатель денег. ИНН — 12 цифр самозанятого.
OPERATOR_NAME=
OPERATOR_INN=
OPERATOR_EMAIL=

# Длинная случайная строка. Журнал: /ledger?token=...
LEDGER_TOKEN=

# ГГГГ-ММ-ДД. День публичного открытия. Если пусто и YOOKASSA_LIVE=yes, берётся этот день.
LAUNCHED_AT=

PRICE_RUB=690
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data

# Оценка комиссии банковской карты: 3,5% и НДС 22% на сумму комиссии, не на платёж.
# ЮMoney и T-Pay по таблице ЮKassa идут без НДС на комиссию — фактическое удержание меньше.
YOOKASSA_FEE_RATE=0.035
YOOKASSA_FEE_VAT_RATE=0.22

# НПД с дохода от физического лица. Магазин самозанятого в ЮKassa принимает оплату от физлиц.
NPD_TAX_RATE=0.04
